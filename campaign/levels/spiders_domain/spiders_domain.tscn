[sub_resource type="Shader" id="Shader_53lkk"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.2.1.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx;
uniform sampler2D waterfall_texture : repeat_enable, filter_linear,source_color;
uniform sampler2D water_break_texture : repeat_enable, filter_linear;
uniform float water_speed = 1.0;
uniform float break_speed = 1.0;
uniform float break_desync_speed = 0.1;
uniform vec2 water_break_scale = vec2(1.0,1.0);
uniform float edges_break = 1.0;
uniform float break_mult = 1.0;
uniform vec2 water_uv_scale = vec2(1.0,1.0);

void vertex() {
}






void fragment() {
	vec2 break_uv = (UV + vec2(0.0,TIME*break_speed))*water_break_scale;
	float b = texture(water_break_texture,break_uv).r;
	b += texture(water_break_texture,break_uv*break_desync_speed + vec2(0.5+TIME*break_desync_speed,TIME*break_desync_speed)).r;
	b += texture(water_break_texture,break_uv*break_desync_speed*1.1 + vec2(0.3-TIME*break_desync_speed*1.3,TIME*break_desync_speed)).r;
	//b *= 0.333;
	float edges = 1.0 -(0.5 - sin(UV.x*PI)*0.5);
	//ALBEDO.r = edges;
	b *= 1.0 - (1.0 - edges*(1.0 - edges_break) + 1.0*edges_break);
	b *= break_mult;
	b = clamp(roundEven(b),0.0,1.0);
	ALPHA = b;
	
	vec2 water_uv = (UV + vec2(0.0, TIME*water_speed))*water_uv_scale;
	vec3 col = texture(waterfall_texture,water_uv).rgb;
	ALBEDO = col;
	
}




"


[sub_resource type="Shader" id="Shader_8d4ys"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.2.1.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_disabled,diffuse_toon,specular_disabled;
uniform vec4 color_base : source_color;
uniform vec4 color_highlight : source_color;
uniform vec4 color_trail : source_color;
uniform sampler2D slash_texture : source_color,filter_linear_mipmap,repeat_disable;
uniform float progress : hint_range(0.0, 1.0, 0.01);
uniform float emission_strength = 1.0;

void vertex() {
}


void fragment() {
	vec2 uv = UV+vec2(1.0-progress*2.0,progress*2.0-1.0);
	
	float trail = texture(slash_texture,uv-vec2(1.0-progress*2.0,progress*2.0-1.0)*0.8).r;
	ALBEDO = mix(color_base.rgb,color_trail.rgb,trail);
	ALPHA = trail*color_trail.a;
	
	vec3 slash = texture(slash_texture,uv).rgb;
	vec3 slash_2 = texture(slash_texture,uv-vec2(1.0-progress*2.0,progress*2.0-1.0)*0.3).rgb;
	ALBEDO = mix(ALBEDO, color_base.rgb, slash_2.g);
	ALPHA += slash_2.g*color_base.a*2.0;
	
	ALBEDO = mix(ALBEDO,color_highlight.rgb,slash.b*color_highlight.a);
	
	ALBEDO = mix(ALBEDO,color_trail.rgb,trail*color_trail.a);
	
	ALPHA *= 1.0-clamp(uv.x,0.0,1.0);
	
	ALPHA *= clamp((1.0-progress)*5.0,0.0,1.0);
	
	ALPHA = clamp(ALPHA,0.0,1.0);
	
	ALPHA = round(ALPHA+0.4);
	EMISSION = ALBEDO*emission_strength;
}
"


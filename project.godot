[layer_names]

3d_render/layer_2="culled by sight"
3d_render/layer_3="invisible to eyes"
3d_render/layer_4="invisible to senses"
3d_render/layer_5="does not recieve decal"
3d_physics/layer_1="generic physics"
3d_physics/layer_2="player"
3d_physics/layer_3="generic entity"
3d_physics/layer_4="interactable"
3d_physics/layer_5="special areas"
3d_physics/layer_6="hurtbox"
3d_physics/layer_7="projectile entity"
3d_physics/layer_8="non_collision_environment"

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_3d=2

[shader_globals]

SunshineClouds_CloudShadowStrength={
"type": "float",
"value": 1.0
}
day_color_influence={
"type": "float",
"value": 0.065
}
SunshineClouds_StartingOffset={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
SunshineClouds_ShapeSpeedMultiplier={
"type": "float",
"value": 0.0
}
vertex_snap_scale={
"type": "float",
"value": 500.0
}
monochrome={
"type": "float",
"value": 0.0
}
